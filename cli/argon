#!/usr/bin/env node
'use strict';
// Compatibility shim: `argon` was renamed to `gemini-relay`. Runs it in this process (so signals still reach agy).
const fs = require('fs');
const path = require('path');
const relay = path.join(path.dirname(fs.realpathSync(__filename)), 'gemini-relay');
process.argv[1] = relay;
require(relay).cli();
