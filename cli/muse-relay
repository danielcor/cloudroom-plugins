#!/usr/bin/env node
'use strict';
// muse-relay: run Meta Muse Code (Muse Wonder Full) headless through `muse exec`. No dependencies, Node >= 20.
const fs = require('fs');
const os = require('os');
const path = require('path');
const crypto = require('crypto');
const { spawn, spawnSync } = require('child_process');

const DEFAULT_MODEL = 'muse-wonder-full-1.0';
const INSTALL_URL = 'https://dev.meta.ai/install.sh';
const KEY_ENV = 'META_API_KEY';
const LOGIN_ENV = 'MUSE_AUTH_B64';
const AUTH_FILE = path.join(process.env.XDG_CONFIG_HOME || path.join(os.homedir(), '.config'), 'muse', 'auth.json');
const CACHE_DIR = process.env.MUSE_RELAY_CACHE_DIR || path.join(os.homedir(), '.cache', 'muse-relay');
// Every run: contributor mode off, no Claude Code / Codex personal rules or skills, no reminder
// observers (extra model calls), no user or managed hooks. Then permissions skipped, like argon:
// no approvals, no OS sandbox, no questions (one turn cannot answer them), project rules loaded.
const CLEAN_FLAGS = ['--contributor-mode', 'off', '--no-foreign-personal-context', '--disable-reminders',
  '-c', 'managed_hooks_path=null', '-c', 'hooks={}'];
const SKIP_PERMISSION_FLAGS = ['--disable-approval', '--disable-sandbox', '--disable-request-user-input', '--trust-workspace'];
const EFFORTS = ['minimal', 'low', 'medium', 'high', 'xhigh', 'max'];
const NOISE = /^muse: (workspace root|workspace trust|Agent delegation)/;

const USAGE = `usage: muse-relay <command>
  setup                     install muse and your plan login if missing (idempotent)
  export-login >> .env      print ${LOGIN_ENV}=... for your plan login (refuses to print to a terminal)
  export-key >> .env        print ${KEY_ENV}=... (pay-per-token API fallback; refuses to print to a terminal)
  models                    list models (contributor variants left out)
  run [--model M] [--effort ${EFFORTS.join('|')}] [--new | --session ID] [PROMPT]
                            one turn in the cwd (prompt may come from stdin); continues the
                            last session for this cwd unless --new
default model: ${DEFAULT_MODEL}`;

// Run on the paired desktop (via room-cli mac run) to print its Muse login file, base64 on one line.
const DESKTOP_SCRIPT = `
f="\${XDG_CONFIG_HOME:-$HOME/.config}/muse/auth.json"
[ -s "$f" ] || { echo "no Muse login on the desktop ($f)" >&2; exit 1; }
base64 < "$f" | tr -d '\\n'
`;

function parseArgs(argv) {
  const [cmd, ...rest] = argv;
  const opts = { model: DEFAULT_MODEL, effort: null, fresh: false, session: null };
  const words = [];
  const need = (i, flag) => {
    if (i + 1 >= rest.length) throw new Error(`${flag} needs a value`);
    return rest[i + 1];
  };
  for (let i = 0; i < rest.length; i++) {
    const a = rest[i];
    if (a === '--') { words.push(...rest.slice(i + 1)); break; }
    else if (a === '--model') opts.model = need(i++, a);
    else if (a === '--effort') opts.effort = need(i++, a);
    else if (a === '--session') opts.session = need(i++, a);
    else if (a === '--new') opts.fresh = true;
    else if (a.startsWith('--') && cmd === 'run') throw new Error(`unknown option ${a}`);
    else words.push(a);
  }
  if (opts.fresh && opts.session) throw new Error('--new and --session are mutually exclusive');
  if (opts.model.endsWith('-contributor')) throw new Error('contributor models are off: they let Meta train on the session');
  if (opts.effort && !EFFORTS.includes(opts.effort)) throw new Error(`--effort must be one of ${EFFORTS.join(', ')}`);
  return { cmd, opts, prompt: words.length ? words.join(' ') : null };
}

function museArgs(opts, session, promptFile) {
  return ['exec', '--json', '--session-id', session, '--model', opts.model,
    ...(opts.effort ? ['--reasoning-effort', opts.effort] : []),
    ...CLEAN_FLAGS, ...SKIP_PERMISSION_FLAGS, '--prompt-file', promptFile];
}

const clip = (s, n) => (s.length > n ? s.slice(0, n - 1) + '…' : s);
const firstLine = (s) => String(s).split('\n').find((l) => l.trim()) || '';

// Turns one `muse exec --json` event into text for stdout; tracks the session id and errors in st.
function render(ev, st) {
  let out = '';
  const p = ev.payload || {};
  if (ev.stream && ev.stream.kind === 'session') st.session = ev.stream.id;
  if (ev.payload_type === 'run.output.delta' && p.text) {
    out += p.text;
    st.bol = p.text.endsWith('\n');
  } else if (ev.payload_type === 'tool.result') {
    const facts = p.correlation_facts || {};
    const ok = facts.outcome === 'success';
    out += `${st.bol ? '' : '\n'}[tool] ${facts.tool_name || 'tool'} ${ok ? '->' : '!!'} ${clip(firstLine(p.text || facts.outcome || ''), 100)}\n`;
    st.bol = true;
  } else if (ev.payload_type === 'run.model.configured') {
    st.model = p.model_id;
  } else if (ev.payload_type === 'run.usage') {
    const sum = (k) => (p.models || []).reduce((n, m) => n + (m[k] || 0), 0);
    st.tokens = { in: sum('input_tokens'), out: sum('output_tokens') };
  } else if (ev.payload_type && ev.payload_type.startsWith('run.terminal.')) {
    st.terminal = p.terminal;
    if (p.terminal !== 'completed') st.error = p.reason || `muse run ${p.terminal}`;
  }
  return out;
}

const museBin = () => {
  const dirs = [...(process.env.PATH || '').split(path.delimiter), path.join(os.homedir(), '.local', 'bin')];
  return dirs.filter(Boolean).map((d) => path.join(d, 'muse')).find((p) => fs.existsSync(p)) || null;
};

const readCache = () => { try { return JSON.parse(fs.readFileSync(path.join(CACHE_DIR, 'sessions.json'), 'utf8')); } catch { return {}; } };
function saveSession(cwd, id) {
  const m = readCache();
  m[cwd] = id;
  fs.mkdirSync(CACHE_DIR, { recursive: true });
  fs.writeFileSync(path.join(CACHE_DIR, 'sessions.json'), JSON.stringify(m, null, 1));
}

// Last assignment wins, like a shell: `export-key >> .env` appends a renewed key.
function parseDotenv(text, key) {
  let value = null;
  for (const l of text.split('\n')) {
    const m = l.match(/^\s*(?:export\s+)?([A-Za-z_][A-Za-z0-9_]*)\s*=\s*(.*?)\s*$/);
    if (m && m[1] === key) value = m[2].replace(/^(['"])(.*)\1$/, '$2');
  }
  return value;
}

// The nearest .env from the cwd up to the git root.
function dotenvValue(key) {
  for (let dir = process.cwd(); ; dir = path.dirname(dir)) {
    try {
      const v = parseDotenv(fs.readFileSync(path.join(dir, '.env'), 'utf8'), key);
      if (v) return v;
    } catch { /* no .env here */ }
    if (fs.existsSync(path.join(dir, '.git')) || dir === path.dirname(dir)) return null;
  }
}

// The login file. A plan login (oauth, from `muse login`) spends the user's plan allowance; an api_key one
// is pay-per-token API billing with no allowance.
const readAuth = () => { try { return JSON.parse(fs.readFileSync(AUTH_FILE, 'utf8')); } catch { return null; } };
const metaOf = (auth) => (auth && auth.providers && auth.providers.meta) || null;
const isPlanLogin = (auth) => { const m = metaOf(auth); return !!(m && m.access_token && m.mechanism !== 'api_key'); };
const storedKey = () => (metaOf(readAuth()) || {}).api_key || null;

function parseLogin(b64) {
  let auth;
  try { auth = JSON.parse(Buffer.from(String(b64).trim(), 'base64').toString('utf8')); } catch { return null; }
  return isPlanLogin(auth) ? auth : null; // an API-key login is never imported: it bills the API, not the plan
}

function writeLogin(auth) {
  fs.mkdirSync(path.dirname(AUTH_FILE), { recursive: true, mode: 0o700 });
  const tmp = `${AUTH_FILE}.${process.pid}.tmp`;
  fs.writeFileSync(tmp, JSON.stringify(auth, null, 2), { mode: 0o600 });
  fs.renameSync(tmp, AUTH_FILE);
}

function loginFromDesktop() {
  const r = spawnSync('room-cli', ['mac', 'run', '--stdin', 'sh -s'], { input: DESKTOP_SCRIPT, encoding: 'utf8', maxBuffer: 1 << 20 });
  if (r.error) return { err: `room-cli not available (${r.error.code || r.error.message})` };
  if (r.status !== 0) return { err: `room-cli mac run failed (exit ${r.status}): ${firstLine(r.stderr || '')}` };
  const auth = parseLogin(r.stdout);
  return auth ? { auth } : { err: 'the desktop has no Muse plan login (run `muse login` there)' };
}

// env MUSE_AUTH_B64, then that key in the nearest .env. Returns where it came from, after saving it.
function loginFromEnv() {
  for (const [from, b64] of [['the environment', process.env[LOGIN_ENV]], ['.env', dotenvValue(LOGIN_ENV)]]) {
    if (!b64) continue;
    const auth = parseLogin(b64);
    if (!auth) throw new Error(`${LOGIN_ENV} from ${from} is not a base64 Muse plan login (an oauth auth.json from \`muse login\`)`);
    writeLogin(auth);
    return from;
  }
  return null;
}

const envKey = () => process.env[KEY_ENV] || dotenvValue(KEY_ENV);
const API_WARNING = `warning: using ${KEY_ENV}: this bills the Muse API per token, not your plan. Use \`muse login\` and \`muse-relay export-login\` instead.`;

// The environment for muse: with a plan login on disk, no META_API_KEY (it would win over the login and
// bill the API). Without one, the explicit ${KEY_ENV} fallback, with a warning.
function museEnv() {
  if (!isPlanLogin(readAuth()) && !loginFromEnv()) {
    const key = envKey();
    if (key || storedKey()) console.error(key ? API_WARNING : API_WARNING.replace(`using ${KEY_ENV}`, 'using the stored API-key login'));
    return key ? { ...process.env, [KEY_ENV]: key } : process.env;
  }
  const { [KEY_ENV]: _drop, ...env } = process.env;
  return env;
}

function runTurn(prompt, opts) {
  const muse = museBin();
  if (!muse) throw new Error('muse is not installed; run `muse-relay setup`');
  const cwd = fs.realpathSync(process.cwd());
  const session = (!opts.fresh && (opts.session || readCache()[cwd])) || crypto.randomUUID();
  const tmp = fs.mkdtempSync(path.join(os.tmpdir(), 'muse-relay-'));
  const promptFile = path.join(tmp, 'prompt.txt');
  fs.writeFileSync(promptFile, prompt, { mode: 0o600 });
  const child = spawn(muse, museArgs(opts, session, promptFile), { stdio: ['ignore', 'pipe', 'pipe'], env: museEnv() });
  const st = { bol: true, session: null, terminal: null, error: null };
  let stderr = '';
  let errBuf = '';
  child.stdout.setEncoding('utf8');
  child.stderr.setEncoding('utf8');
  child.stderr.on('data', (d) => {
    stderr += d;
    errBuf += d;
    const lines = errBuf.split('\n');
    errBuf = lines.pop();
    for (const l of lines) if (!NOISE.test(l)) process.stderr.write(l + '\n');
  });
  let buf = '';
  const line = (l) => {
    if (!l.trim()) return;
    let ev;
    try { ev = JSON.parse(l); } catch { return; }
    process.stdout.write(render(ev, st));
  };
  child.stdout.on('data', (d) => {
    buf += d;
    const parts = buf.split('\n');
    buf = parts.pop();
    parts.forEach(line);
  });
  for (const sig of ['SIGINT', 'SIGTERM']) process.on(sig, () => child.kill(sig));
  child.on('close', (code) => {
    fs.rmSync(tmp, { recursive: true, force: true });
    line(buf);
    if (errBuf && !NOISE.test(errBuf)) process.stderr.write(errBuf + '\n');
    if (!st.bol) process.stdout.write('\n');
    if (st.model) process.stdout.write(`model: ${st.model}${st.tokens ? ` (${st.tokens.in} tokens in, ${st.tokens.out} out)` : ''}\n`);
    if (st.session) {
      saveSession(cwd, st.session);
      process.stdout.write(`session: ${st.session}\n`);
    }
    if (!st.error && !st.terminal) st.error = `muse exited (${code}) without a result${stderr.trim() ? '' : ' and no error output'}`;
    if (st.error && !stderr.includes(st.error)) process.stderr.write(st.error + '\n');
    process.exit(st.error || code ? 1 : 0);
  });
}

// Muse's live model catalog over MSP (`muse serve`), without contributor variants.
function listModels() {
  const muse = museBin();
  if (!muse) throw new Error('muse is not installed; run `muse-relay setup`');
  const child = spawn(muse, ['serve', ...CLEAN_FLAGS.slice(0, 2)], { stdio: ['pipe', 'pipe', 'inherit'], env: museEnv() });
  const send = (m) => child.stdin.write(JSON.stringify({ jsonrpc: '2.0', ...m }) + '\n');
  const timer = setTimeout(() => { console.error('muse-relay: muse serve did not list models in 20 s'); child.kill(); process.exit(1); }, 20_000);
  let buf = '';
  child.stdout.setEncoding('utf8');
  child.stdout.on('data', (d) => {
    buf += d;
    const parts = buf.split('\n');
    buf = parts.pop();
    for (const l of parts) {
      let m;
      try { m = JSON.parse(l); } catch { continue; }
      if (m.error) { console.error(`muse-relay: ${m.error.message}`); child.kill(); process.exit(1); }
      if (m.id === 1) { send({ method: 'initialized' }); send({ id: 2, method: 'model/list', params: {} }); }
      if (m.id === 2) {
        clearTimeout(timer);
        for (const row of m.result.models) if (!row.modelId.endsWith('-contributor')) console.log(row.modelId);
        child.stdin.end(); // muse serve exits on EOF
        setTimeout(() => child.kill(), 5000).unref();
      }
    }
  });
  send({ id: 1, method: 'initialize', params: { clientInfo: { name: 'muse_relay', version: '0.1.0' } } });
}

function setup() {
  if (!museBin()) {
    console.error(`installing muse from ${INSTALL_URL}`);
    const r = spawnSync('bash', ['-c', `curl -fsSL ${INSTALL_URL} | bash`], { stdio: ['ignore', 2, 2] });
    if (r.status !== 0 || !museBin()) throw new Error('muse install failed');
  }
  let from;
  if (isPlanLogin(readAuth())) from = 'plan login already present';
  else if ((from = loginFromEnv())) from = `plan login from ${from} (saved to ${AUTH_FILE})`;
  else {
    const d = loginFromDesktop();
    if (d.auth) {
      writeLogin(d.auth);
      from = `plan login from the paired desktop (saved to ${AUTH_FILE})`;
    } else if (envKey()) {
      console.error(API_WARNING);
      from = `${KEY_ENV} (API billing)`;
    } else {
      throw new Error(`no Muse login: ${LOGIN_ENV} not set, and ${d.err}. Run \`muse-relay export-login >> .env\` on a machine where \`muse login\` worked.`);
    }
  }
  console.error(`login: ${from}`);
  const v = spawnSync(museBin(), ['--version'], { encoding: 'utf8' });
  console.log(`ok: ${museBin()} (${firstLine(v.stdout) || 'muse'}), default model ${DEFAULT_MODEL}`);
}

const refuseTty = (cmd) => {
  if (process.stdout.isTTY) throw new Error(`refusing to print a secret to a terminal; use: muse-relay ${cmd} >> .env`);
};

function exportToEnv(name, value) {
  if (spawnSync('git', ['check-ignore', '-q', '.env']).status === 1) console.error('warning: .env is not gitignored here; do not commit it');
  process.stdout.write(`${name}=${value}\n`);
}

function exportLogin() {
  refuseTty('export-login');
  const file = fs.existsSync(AUTH_FILE) ? fs.readFileSync(AUTH_FILE) : null;
  const b64 = file ? file.toString('base64') : process.env[LOGIN_ENV];
  if (!b64) throw new Error('no Muse login: run `muse login` first');
  if (file && !isPlanLogin(readAuth())) console.error('warning: this login is an API key (bills the API, not your plan). Run `muse login` for a plan login.');
  exportToEnv(LOGIN_ENV, b64);
}

function exportKey() {
  refuseTty('export-key');
  const key = process.env[KEY_ENV] || storedKey();
  if (!key) throw new Error(`no Muse key: set ${KEY_ENV}, or log in with \`muse login\` first`);
  console.error(API_WARNING);
  exportToEnv(KEY_ENV, key);
}

function main(argv) {
  if (!argv.length || ['-h', '--help', 'help'].includes(argv[0])) return console.log(USAGE);
  const { cmd, opts, prompt } = parseArgs(argv);
  if (cmd === 'setup') return setup();
  if (cmd === 'export-login') return exportLogin();
  if (cmd === 'export-key') return exportKey();
  if (cmd === 'models') return listModels();
  if (cmd === 'run') {
    const text = prompt !== null ? prompt : process.stdin.isTTY ? '' : fs.readFileSync(0, 'utf8');
    if (!text.trim()) throw new Error('no prompt given (pass it as an argument or on stdin)');
    return runTurn(text, opts);
  }
  throw new Error(`unknown command ${cmd}\n${USAGE}`);
}

if (require.main === module) {
  try { main(process.argv.slice(2)); } catch (e) { console.error(`muse-relay: ${e.message}`); process.exit(1); }
}
module.exports = { parseArgs, museArgs, render, parseDotenv, parseLogin };
